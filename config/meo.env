MEO_SERVICE_HOST=127.0.0.1
MEO_SERVICE_PORT=7070
MEO_API_URL=http://127.0.0.1:7070

# MQTT broker used to reach the Rust BLE service (blemqtt). Defaults to tcp://localhost:1883.
MEO_MQTT_BROKER=tcp://localhost:1883

# Cloud link, always on. Both are optional overrides for a local cloud (http:// and mqtt:// allowed);
# empty uses the built-in https://meo.agp.io.vn and mqtts://meo.agp.io.vn:8883.
MEO_CLOUD_API_URL=
MEO_CLOUD_MQTT_URL=
